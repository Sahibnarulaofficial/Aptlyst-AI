# ─── Database ────────────────────────────────────────────────────────────────
# Supabase Session Pooler connection string (use port 5432, NOT 6543)
# Get from: Supabase Dashboard → Project Settings → Database → Session pooler
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get all three values from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# JWT settings:
# Modern Supabase projects default to ES256 asymmetric signing via JWKS.
# Legacy/symmetric projects use HS256 with SUPABASE_JWT_SECRET.
SUPABASE_JWT_ALGORITHM=ES256
SUPABASE_JWT_AUDIENCE=authenticated

# JWT Secret — only required if using legacy symmetric HS256 verification.
# NEVER expose this via NEXT_PUBLIC_ or return it in API responses.
# Get from: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ─── Future settings (not implemented yet) ───────────────────────────────────
# OPENAI_API_KEY=
# REDIS_URL=
# STRIPE_SECRET_KEY=
